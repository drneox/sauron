# ── Base de datos ────────────────────────────────────────────────────────────
# Obligatoria para docker compose (sin default en el repo): ponla también en
# el .env de la raíz del proyecto — compose interpola ${POSTGRES_PASSWORD}
# desde ahí, no desde backend/.env.
POSTGRES_PASSWORD=
DATABASE_URL=postgres://postgres:postgres@localhost:5432/asm

# ── IA (Azure AI Foundry / OpenAI-compatible) ───────────────────────────────
# Elige UN formato de AI_BASE_URL según tu recurso en Azure:
#
# A) API v1 (recomendada, sin api-version):
#    AI_BASE_URL=https://<recurso>.openai.azure.com/openai/v1
# B) Clásica Azure OpenAI (con deployment en la URL):
#    AI_BASE_URL=https://<recurso>.openai.azure.com/openai/deployments/<deployment>/chat/completions?api-version=2024-10-21
# C) Foundry Models (catálogo: Llama, Mistral, etc.):
#    AI_BASE_URL=https://<recurso>.services.ai.azure.com/models/chat/completions?api-version=2024-05-01-preview
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# ── Scanner ──────────────────────────────────────────────────────────────────
SCAN_WORKERS=1
# How many modules run concurrently within a single scan (default 6). This
# multiplies with SCAN_WORKERS for the system-wide worst-case concurrent
# request count against a target.
# MODULE_CONCURRENCY=6
# DISCOVER_RATE_LIMIT_MAX=30

# ── Autenticación (RBAC: viewer < operator < admin) ──────────────────────────
# true (default y OBLIGATORIO en cualquier despliegue expuesto): todo /api/*
# exige Bearer token salvo /health, /api/auth/login y /api/auth/bootstrap.
# Con 0 usuarios, POST /api/auth/bootstrap crea el primer admin y devuelve
# su token.
# false: SOLO dev local — todo pasa sin token y /api/auth/me devuelve el
# admin local {id: 0, email: "local@dev", role: "admin"}. Inseguro si el
# puerto es alcanzable desde fuera de localhost.
AUTH_ENABLED=true

# ── Proxy pool (rotación de IP de salida) ────────────────────────────────────
# Desactivado por defecto: todo el tráfico sale directo.
# PROXY_ENABLED=false
# Archivo con un proxy por línea: http://[user:pass@]host:port o socks5h://...
# (socks5h requiere instalar httpx[socks]).
# PROXY_FILE=/ruta/a/proxies.txt
# Gateway rotatorio único (alternativa o complemento a PROXY_FILE):
# PROXY_GATEWAY=http://user:pass@gateway.example.com:8080
# NOTA: la verificación de claves candidatas (secret_verification) NUNCA usa proxy.

# ── Notificaciones de deltas entre scans ─────────────────────────────────────
# Webhook entrante (Slack/Discord/genérico): recibe POST JSON {"text": ...}.
# NOTIFY_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
# Triggers activos (csv; por defecto todos):
# NOTIFY_ON=new_assets,critical_findings,grade_change
# URL del dashboard incluida en el mensaje:
# DASHBOARD_URL=http://localhost:5173

# ── Fuentes opcionales de descubrimiento (se activan si hay key) ────────────
# SECURITYTRAILS_API_KEY=
# OTX_API_KEY=
# HIBP_API_KEY=
# HUNTER_API_KEY=
# GitHub: sin token solo hay repo search (10 req/min); con token sube el
# límite y se habilita el code search en api_exposure.
# GITHUB_TOKEN=

# ── Gate de red (antes del login de la app) ─────────────────────────────────
# HTTP Basic (popup nativo del navegador) — requiere las tres:
# EDGE_AUTH_ENABLED=true
# EDGE_AUTH_USER=
# EDGE_AUTH_PASSWORD=
# Whitelist de IPs (csv, admite CIDR). Local (loopback/LAN) SIEMPRE pasa.
# Rangos oficiales de Netskope NewEdge ya preparados:
# EDGE_ALLOWED_IPS=8.36.116.0/24,8.39.144.0/24,31.186.239.0/24,163.116.128.0/17,162.10.0.0/17
# Peers de confianza para CF-Connecting-IP (csv CIDRs; default
# "127.0.0.1,172.16.0.0/12" = cloudflared en el host + red docker).
# X-Forwarded-For crudo NUNCA se usa para la whitelist.
# EDGE_TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12
